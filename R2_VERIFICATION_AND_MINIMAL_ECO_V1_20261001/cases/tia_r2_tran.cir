TIA r2 step actual manufacturer model
.include "../../models/OPA4388_ORIGINAL.LIB"
V5 v5 0 5
VCM vcm 0 2.5
VROW row 0 PULSE(2.5 2.4375 200u 1u 1u 500u 2m)
X1 vcm minus v5 0 drv OPA4388
RISO drv tap 1k
RSENSE col minus 10k
RF tap col 4.99k
CF tap col 2.2n
CHF drv minus 22p
RARRAY col row 200
CL col 0 1n
RADC tap ain 100
CADC ain 0 10n
RIN ain 0 1meg
.control
set wr_singlescale
set wr_vecnames
tran 200n 900u 0 200n
wrdata trace.txt v(row) v(col) v(tap) v(drv) v(ain)
quit
.endc
.end
